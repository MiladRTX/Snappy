<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (the tray icon); all UI is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 asks WinForms apps to set DPI mode in code; this is a WPF app, which reads it from the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\snappy.ico</ApplicationIcon>
    <Product>Snappy</Product>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, Button, Color, ...; keep WPF's unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\snappy.ico" />
    <InternalsVisibleTo Include="Snappy.Tests" />
  </ItemGroup>

</Project>
