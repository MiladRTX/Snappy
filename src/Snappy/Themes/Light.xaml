<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- shadcn/ui "zinc" palette, light. -->
    <SolidColorBrush x:Key="Snappy.Foreground" Color="#09090B" />
    <SolidColorBrush x:Key="Snappy.Muted" Color="#F4F4F5" />
    <SolidColorBrush x:Key="Snappy.MutedForeground" Color="#71717A" />
    <SolidColorBrush x:Key="Snappy.Border" Color="#E4E4E7" />
    <SolidColorBrush x:Key="Snappy.Accent" Color="#F4F4F5" />
    <SolidColorBrush x:Key="Snappy.Primary" Color="#18181B" />
    <SolidColorBrush x:Key="Snappy.PrimaryForeground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Snappy.Destructive" Color="#DC2626" />

    <!-- Floating surfaces (toolbar, cursor card, toast, menu). -->
    <LinearGradientBrush x:Key="Snappy.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F8F8F9" />
    </LinearGradientBrush>
    <!-- 1px rim, slightly darker toward the bottom. -->
    <LinearGradientBrush x:Key="Snappy.SurfaceEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#12000000" />
        <GradientStop Offset="1" Color="#24000000" />
    </LinearGradientBrush>

    <!--
        Glass (toolbar and hint): a milky white tint over the blurred screen, a bright sheen and a
        white rim. The tint is at full strength over dark windows and thins out over light
        content (see OverlayWindow.AimFrost).
    -->
    <LinearGradientBrush x:Key="Snappy.GlassTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D1FFFFFF" />
        <GradientStop Offset="1" Color="#E0F6F6F7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Snappy.GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#66FFFFFF" />
        <GradientStop Offset="0.6" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Snappy.GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E6FFFFFF" />
        <GradientStop Offset="0.5" Color="#40FFFFFF" />
        <GradientStop Offset="1" Color="#1F000000" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Snappy.GlassMutedForeground" Color="#3F3F46" />

    <!-- Active segment: a brighter pane of glass. -->
    <LinearGradientBrush x:Key="Snappy.SegmentActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F2FFFFFF" />
        <GradientStop Offset="1" Color="#D9FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Snappy.SegmentActiveEdge" Color="#1A000000" />
    <SolidColorBrush x:Key="Snappy.SegmentHover" Color="#0A000000" />

    <SolidColorBrush x:Key="Snappy.KbdBackground" Color="#0A000000" />
    <SolidColorBrush x:Key="Snappy.KbdBorder" Color="#17000000" />
    <SolidColorBrush x:Key="Snappy.Divider" Color="#17000000" />
</ResourceDictionary>
