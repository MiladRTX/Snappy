<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- shadcn/ui "zinc" palette, dark. -->
    <SolidColorBrush x:Key="Snappy.Foreground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Snappy.Muted" Color="#27272A" />
    <SolidColorBrush x:Key="Snappy.MutedForeground" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Snappy.Border" Color="#27272A" />
    <SolidColorBrush x:Key="Snappy.Accent" Color="#27272A" />
    <SolidColorBrush x:Key="Snappy.Primary" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Snappy.PrimaryForeground" Color="#18181B" />
    <SolidColorBrush x:Key="Snappy.Destructive" Color="#F87171" />
    <SolidColorBrush x:Key="Snappy.Success" Color="#4ADE80" />

    <!-- Settings window: page background, sidebar, cards, focus ring, switch track. -->
    <SolidColorBrush x:Key="Snappy.Background" Color="#0B0B0D" />
    <SolidColorBrush x:Key="Snappy.Sidebar" Color="#101013" />
    <SolidColorBrush x:Key="Snappy.CardBackground" Color="#141417" />
    <SolidColorBrush x:Key="Snappy.Ring" Color="#71717A" />
    <SolidColorBrush x:Key="Snappy.SwitchTrack" Color="#3F3F46" />

    <!-- Floating surfaces (toolbar, cursor card, toast, menu): lit from above. -->
    <LinearGradientBrush x:Key="Snappy.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1E1E22" />
        <GradientStop Offset="1" Color="#151518" />
    </LinearGradientBrush>
    <!-- 1px rim, brightest along the top edge. -->
    <LinearGradientBrush x:Key="Snappy.SurfaceEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="0.45" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#0DFFFFFF" />
    </LinearGradientBrush>

    <!-- Menu items: a clear highlight under the pointer, a little stronger while pressed. -->
    <SolidColorBrush x:Key="Snappy.ItemHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Snappy.ItemPressed" Color="#26FFFFFF" />

    <!-- Active segment: a raised key, lighter than the surface around it. -->
    <LinearGradientBrush x:Key="Snappy.SegmentActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="1" Color="#1AFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Snappy.SegmentActiveEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#66FFFFFF" />
        <GradientStop Offset="1" Color="#14FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Snappy.SegmentHover" Color="#12FFFFFF" />

    <SolidColorBrush x:Key="Snappy.KbdBackground" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Snappy.KbdBorder" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Snappy.Divider" Color="#1AFFFFFF" />
</ResourceDictionary>
