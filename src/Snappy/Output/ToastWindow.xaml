<Window x:Class="Snappy.Output.ToastWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snappy"
        Width="408"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Snappy.Font}"
        Foreground="{DynamicResource Snappy.Foreground}">
    <!-- The 24px margin leaves room for the shadow. -->
    <Grid x:Name="Root" Margin="24" Opacity="0" MouseLeftButtonUp="OnBodyClick">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" X="28" />
        </Grid.RenderTransform>
        <Border CornerRadius="14" Background="{DynamicResource Snappy.Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.4" Color="Black" />
            </Border.Effect>
        </Border>
        <Border Padding="12" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Snappy.SurfaceEdge}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ThumbFrame"
                        Width="96"
                        Height="64"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        CornerRadius="7"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Snappy.KbdBorder}"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="Thumb" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="IconBadge"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Background="{DynamicResource Snappy.Muted}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="IconGlyph" HorizontalAlignment="Center" Style="{StaticResource Snappy.Icon}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageText"
                               Margin="0,2,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Snappy.MutedForeground}"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="DetailText"
                               Margin="0,2,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Snappy.MutedForeground}"
                               Visibility="Collapsed" />
                    <StackPanel x:Name="Actions" Margin="0,10,0,0" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Margin="0,0,6,0" Style="{StaticResource Snappy.PrimaryButton}" Click="OnOpenClick">Open</Button>
                        <Button Style="{StaticResource Snappy.OutlineButton}" Click="OnShowInFolderClick">Show in folder</Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="26"
                        Height="26"
                        Margin="8,-5,-5,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource Snappy.IconButton}"
                        Click="OnCloseClick">
                    <TextBlock Style="{StaticResource Snappy.Icon}" FontSize="10" Text="&#xE711;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
