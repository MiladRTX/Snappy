<Window x:Class="Snappy.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:Snappy.Overlay"
        xmlns:ui="clr-namespace:Snappy.Ui"
        Title="Snappy"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Snappy.Font}"
        Foreground="{DynamicResource Snappy.Foreground}"
        Cursor="Cross">
    <Grid>
        <!-- This display's slice of the frozen desktop, one image pixel per screen pixel. -->
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Dim layer. It never changes while the highlight moves, so it never has to be redrawn. -->
        <Rectangle x:Name="Dim" Fill="Black" Opacity="0" IsHitTestVisible="False" />

        <Canvas IsHitTestVisible="False">
            <!--
                The highlighted area, undimmed: the same frozen pixels, shown only inside the
                highlight. Moving it redraws just the old and new area, not the whole display.
            -->
            <Rectangle x:Name="Lit" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Rectangle.Fill>
                    <ImageBrush x:Name="LitBrush" ViewboxUnits="Absolute" Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <!-- A covered window rendered by itself, over its highlight, as it will be captured. -->
            <Rectangle x:Name="WindowRender" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Rectangle.Fill>
                    <ImageBrush x:Name="WindowRenderBrush" ViewboxUnits="Absolute" Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Border x:Name="SelectionBorder" BorderBrush="White" Visibility="Collapsed" />

            <!-- Card that follows the cursor: magnifier, size, position, color. -->
            <Grid x:Name="Card" Visibility="Collapsed">
                <!-- Shadow, rendered once and cached so moving the card doesn't re-blur it. -->
                <Border CornerRadius="12" Background="{DynamicResource Snappy.Surface}" CacheMode="BitmapCache">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border Padding="6"
                        CornerRadius="12"
                        BorderThickness="1"
                        Background="{DynamicResource Snappy.Surface}"
                        BorderBrush="{DynamicResource Snappy.SurfaceEdge}">
                    <StackPanel>
                        <Border x:Name="Loupe"
                                Width="120"
                                Height="120"
                                Margin="0,0,0,7"
                                CornerRadius="5"
                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Border.Background>
                                <ImageBrush x:Name="LoupeBrush" ViewboxUnits="Absolute" Stretch="Fill" />
                            </Border.Background>
                            <Grid>
                                <Border Width="10" Height="10" BorderBrush="#99000000" BorderThickness="1" />
                                <Border Width="8" Height="8" BorderBrush="White" BorderThickness="1" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="3,0" Orientation="Horizontal">
                            <Border x:Name="Swatch"
                                    Width="11"
                                    Height="11"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Snappy.KbdBorder}" />
                            <TextBlock x:Name="CardPrimary"
                                       MaxWidth="260"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <TextBlock x:Name="CardSecondary"
                                   Margin="3,2,3,1"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Snappy.MutedForeground}"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>

        <!-- Mode toolbar, on the display the cursor was on. Same solid surface as the tray menu. -->
        <Grid x:Name="Toolbar"
              Margin="0,28,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Cursor="Arrow"
              Opacity="0"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ToolbarShift" Y="-16" />
            </Grid.RenderTransform>

            <!-- Shadow, rendered once and cached so the sliding pill doesn't make it re-blur. -->
            <Border CornerRadius="14" Background="{DynamicResource Snappy.Surface}" CacheMode="BitmapCache">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.45" Color="Black" />
                </Border.Effect>
            </Border>
            <Border Padding="5"
                    CornerRadius="14"
                    BorderThickness="1"
                    Background="{DynamicResource Snappy.Surface}"
                    BorderBrush="{DynamicResource Snappy.SurfaceEdge}">
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <!-- No shadow on the pill: it moves, and a moving shadow re-blurs every frame. -->
                        <Border x:Name="SegmentPill"
                                CornerRadius="8"
                                BorderThickness="1"
                                Background="{DynamicResource Snappy.SegmentActive}"
                                BorderBrush="{DynamicResource Snappy.SegmentActiveEdge}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PillShift" />
                            </Border.RenderTransform>
                        </Border>
                        <RadioButton x:Name="RegionButton"
                                     Grid.Column="0"
                                     Style="{StaticResource Snappy.Segment}"
                                     Tag="{x:Static overlay:CaptureMode.Region}"
                                     Click="OnModeClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:FaIcon Width="15" Height="15" Glyph="{StaticResource Fa.CropSimple}" />
                                <TextBlock Margin="9,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Region" />
                                <Border Style="{StaticResource Snappy.Kbd}">
                                    <TextBlock Style="{StaticResource Snappy.KbdText}" Text="R" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WindowButton"
                                     Grid.Column="1"
                                     Style="{StaticResource Snappy.Segment}"
                                     Tag="{x:Static overlay:CaptureMode.Window}"
                                     Click="OnModeClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:FaIcon Width="15" Height="15" Glyph="{StaticResource Fa.WindowMaximize}" />
                                <TextBlock Margin="9,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Window" />
                                <Border Style="{StaticResource Snappy.Kbd}">
                                    <TextBlock Style="{StaticResource Snappy.KbdText}" Text="W" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ScreenButton"
                                     Grid.Column="2"
                                     Style="{StaticResource Snappy.Segment}"
                                     Tag="{x:Static overlay:CaptureMode.Screen}"
                                     Click="OnModeClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:FaIcon Width="15" Height="15" Glyph="{StaticResource Fa.Display}" />
                                <TextBlock Margin="9,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Screen" />
                                <Border Style="{StaticResource Snappy.Kbd}">
                                    <TextBlock Style="{StaticResource Snappy.KbdText}" Text="F" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource Snappy.Divider}" />
                    <Button Style="{StaticResource Snappy.IconButton}" Click="OnCloseClick">
                        <ui:FaIcon Width="14" Height="14" Glyph="{StaticResource Fa.Xmark}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
