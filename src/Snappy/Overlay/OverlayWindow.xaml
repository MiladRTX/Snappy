<Window x:Class="Snappy.Overlay.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:Snappy.Overlay"
        Title="Snappy"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Snappy.Font}"
        Foreground="{DynamicResource Snappy.Foreground}"
        Cursor="Cross">
    <Grid>
        <!-- This display's slice of the frozen desktop, one image pixel per screen pixel. -->
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Dim layer; the highlighted area is cut out of it. -->
        <Path x:Name="Dim" Fill="Black" Opacity="0" IsHitTestVisible="False" />

        <Canvas IsHitTestVisible="False">
            <Border x:Name="SelectionBorder" BorderBrush="White" Visibility="Collapsed" />

            <!-- Card that follows the cursor: magnifier, size, position, color. -->
            <Grid x:Name="Card" Visibility="Collapsed">
                <Border CornerRadius="12" Background="{DynamicResource Snappy.Surface}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border Padding="6" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Snappy.SurfaceEdge}">
                    <StackPanel>
                        <Border x:Name="Loupe"
                                Width="120"
                                Height="120"
                                Margin="0,0,0,7"
                                CornerRadius="5"
                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Border.Background>
                                <ImageBrush x:Name="LoupeBrush" ViewboxUnits="Absolute" Stretch="Fill" />
                            </Border.Background>
                            <Grid>
                                <Border Width="10" Height="10" BorderBrush="#99000000" BorderThickness="1" />
                                <Border Width="8" Height="8" BorderBrush="White" BorderThickness="1" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="3,0" Orientation="Horizontal">
                            <Border x:Name="Swatch"
                                    Width="11"
                                    Height="11"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Snappy.KbdBorder}" />
                            <TextBlock x:Name="CardPrimary"
                                       MaxWidth="260"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <TextBlock x:Name="CardSecondary"
                                   Margin="3,2,3,1"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Snappy.MutedForeground}"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>

        <!-- Mode toolbar, shown on the display the cursor was on. -->
        <StackPanel x:Name="Toolbar"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Cursor="Arrow"
                    Opacity="0"
                    Visibility="Collapsed">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ToolbarShift" Y="-16" />
            </StackPanel.RenderTransform>

            <Grid>
                <Border CornerRadius="14" Background="{DynamicResource Snappy.Surface}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="16" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                </Border>
                <!--
                    Frosted glass: a blurred copy of the frozen screen behind the toolbar, at half
                    strength like the dimmed screen around it, so it stays dark over bright windows.
                -->
                <Grid x:Name="Frost" Opacity="0.5">
                    <Rectangle x:Name="FrostImage" Margin="-32">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="FrostBrush" ViewboxUnits="Absolute" Stretch="Fill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Quality" />
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
                <Border Padding="5"
                        CornerRadius="14"
                        BorderThickness="1"
                        Background="{DynamicResource Snappy.SurfaceGlass}"
                        BorderBrush="{DynamicResource Snappy.SurfaceEdge}">
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SegmentPill"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    Background="{DynamicResource Snappy.SegmentActive}"
                                    BorderBrush="{DynamicResource Snappy.SegmentActiveEdge}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PillShift" />
                                </Border.RenderTransform>
                            </Border>
                            <RadioButton x:Name="RegionButton"
                                         Grid.Column="0"
                                         Style="{StaticResource Snappy.Segment}"
                                         Tag="{x:Static overlay:CaptureMode.Region}"
                                         Click="OnModeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Snappy.Icon}" FontSize="15" Text="&#xE7A8;" />
                                    <TextBlock Margin="9,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Region" />
                                    <Border Style="{StaticResource Snappy.Kbd}">
                                        <TextBlock Style="{StaticResource Snappy.KbdText}" Text="R" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="WindowButton"
                                         Grid.Column="1"
                                         Style="{StaticResource Snappy.Segment}"
                                         Tag="{x:Static overlay:CaptureMode.Window}"
                                         Click="OnModeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Snappy.Icon}" FontSize="15" Text="&#xE737;" />
                                    <TextBlock Margin="9,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Window" />
                                    <Border Style="{StaticResource Snappy.Kbd}">
                                        <TextBlock Style="{StaticResource Snappy.KbdText}" Text="W" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ScreenButton"
                                         Grid.Column="2"
                                         Style="{StaticResource Snappy.Segment}"
                                         Tag="{x:Static overlay:CaptureMode.Screen}"
                                         Click="OnModeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Snappy.Icon}" FontSize="15" Text="&#xE7F4;" />
                                    <TextBlock Margin="9,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Screen" />
                                    <Border Style="{StaticResource Snappy.Kbd}">
                                        <TextBlock Style="{StaticResource Snappy.KbdText}" Text="F" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource Snappy.Divider}" />
                        <Button Style="{StaticResource Snappy.IconButton}" Click="OnCloseClick">
                            <TextBlock Style="{StaticResource Snappy.Icon}" FontSize="13" Text="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- What to do next in the current mode. -->
            <Border Margin="0,12,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    CornerRadius="999"
                    BorderThickness="1"
                    Background="{DynamicResource Snappy.SurfaceGlass}"
                    BorderBrush="{DynamicResource Snappy.SurfaceEdge}"
                    TextElement.FontSize="12"
                    TextElement.Foreground="{DynamicResource Snappy.MutedForeground}">
                <Grid>
                    <StackPanel x:Name="RegionHint" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Drag to capture an area" />
                        <Ellipse Style="{StaticResource Snappy.Dot}" />
                        <Border Style="{StaticResource Snappy.Kbd}">
                            <TextBlock Style="{StaticResource Snappy.KbdText}" Text="Esc" />
                        </Border>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="to cancel" />
                    </StackPanel>
                    <StackPanel x:Name="WindowHint" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center" Text="Click a window to capture it" />
                        <Ellipse Style="{StaticResource Snappy.Dot}" />
                        <Border Style="{StaticResource Snappy.Kbd}">
                            <TextBlock Style="{StaticResource Snappy.KbdText}" Text="Esc" />
                        </Border>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="to cancel" />
                    </StackPanel>
                    <StackPanel x:Name="ScreenHint" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center" Text="Click a display" />
                        <Ellipse Style="{StaticResource Snappy.Dot}" />
                        <Border Style="{StaticResource Snappy.Kbd}">
                            <TextBlock Style="{StaticResource Snappy.KbdText}" Text="Enter" />
                        </Border>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="all displays" />
                        <Ellipse Style="{StaticResource Snappy.Dot}" />
                        <Border Style="{StaticResource Snappy.Kbd}">
                            <TextBlock Style="{StaticResource Snappy.KbdText}" Text="Esc" />
                        </Border>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="to cancel" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
